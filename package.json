{
  "name": "mlmd",
  "version": "0.1.0",
  "description": "A CLI tool for describing neural network architectures as a DSL",
  "type": "module",
  "packageManager": "npm@10.9.0",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "bin": "dist/bin/mlmd.js",
  "files": [
    "dist",
    "syntaxes",
    "languages",
    "examples"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run && npm run test:rust",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "test:rust": "cargo test --manifest-path tests/e2e/rust/Cargo.toml",
    "test:rust:update": "npm run build && npm run generate-examples && npm run test:rust"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
