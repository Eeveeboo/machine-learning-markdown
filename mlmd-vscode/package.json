{
  "name": "mlmd-vscode",
  "displayName": "MLMD Neural Network DSL",
  "description": "VS Code extension for the MLMD neural network DSL",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:mlmd"],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mlmd",
        "extensions": [".mlmd"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mlmd",
        "scopeName": "source.mlmd",
        "path": "./syntaxes/mlmd.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mlmd.visualize",
        "title": "MLMD: Visualize Network"
      },
      {
        "command": "mlmd.generate",
        "title": "MLMD: Generate Code"
      },
      {
        "command": "mlmd.lint",
        "title": "MLMD: Lint File"
      }
    ],
    "configuration": {
      "title": "MLMD",
      "properties": {
        "mlmd.serverPath": {
          "type": "string",
          "default": "mlmd",
          "description": "Path to the mlmd CLI executable used as the LSP server."
        },
        "mlmd.defaultTarget": {
          "type": "string",
          "enum": ["pytorch", "keras", "candle"],
          "default": "pytorch",
          "description": "Default code generation target backend."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
